{
    "name": "softspring/user-bundle",
    "description": "A complete user bundle",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": false,
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "doctrine/doctrine-bundle": "^2.10 | ^3.0",
        "doctrine/orm": "^3.3 | ^4.0",
        "softspring/crudl-controller": "^6.0@dev",
        "softspring/doctrine-paginator": "^6.0@dev",
        "softspring/doctrine-query-filters": "^6.0@dev",
        "softspring/doctrine-target-entity-resolver": "^6.0@dev",
        "softspring/events": "^6.0@dev",
        "softspring/mime-translatable": "^6.0@dev",
        "softspring/permissions-bundle": "^6.0@dev",
        "softspring/twig-extra-bundle": "^6.0@dev",
        "symfony/http-foundation": "^6.4|^7.4|^8.0",
        "symfony/http-kernel": "^6.4|^7.4|^8.0",
        "symfony/security-bundle": "^6.4|^7.4|^8.0",
        "symfony/translation": "^6.4|^7.4|^8.0",
        "symfony/twig-bundle": "^6.4|^7.4|^8.0",
        "symfony/validator": "^6.4|^7.4|^8.0",
        "symfony/yaml": "^6.4|^7.4|^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "fakerphp/faker": "^1.21",
        "friendsofphp/php-cs-fixer": "^3.89",
        "hwi/oauth-bundle": "^2.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.2",
        "softspring/account-bundle": "^6.0@dev",
        "softspring/doctrine-templates": "^6.0@dev",
        "softspring/mailer-bundle": "^6.0@dev",
        "softspring/media-bundle": "^6.0@dev",
        "symfony/browser-kit": "^6.4|^7.4|^8.0",
        "symfony/css-selector": "^6.4|^7.4|^8.0",
        "symfony/dom-crawler": "^6.4|^7.4|^8.0",
        "symfony/form": "^6.4|^7.4|^8.0",
        "symfony/http-client": "^6.4|^7.4|^8.0",
        "symfony/mailer": "^6.4|^7.4|^8.0",
        "symfony/phpunit-bridge": "^6.4|^7.4|^8.0"
    },
    "suggest": {
        "softspring/mailer-bundle": "Integrates with softspring's mailer bundle",
        "softspring/media-bundle": "Stores media files for avatars",
        "hwi/oauth-bundle": "Integrate oauth clients"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\UserBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\UserBundle\\Tests\\TestApplication\\": "tests/TestApplication/src",
            "Softspring\\UserBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "phpstan/extension-installer": true
        }
    }
}
