{% trans_default_domain 'sfs_user' %}

{% set render_row = render_row|default(true) %}
{% set fill_remaining_columns = fill_remaining_columns|default(render_row) %}

{% if render_row %}
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3 mb-4">
{% endif %}
    <div class="col">
        {% include '@SfsUser/admin/users/widget-total.html.twig' %}
    </div>

    {% if supports_confirmable|default(sfs_user_is('confirmable')) %}
        <div class="col">
            {% include '@SfsUser/admin/users/widget-pending-confirm.html.twig' %}
        </div>
    {% endif %}

    {% if fill_remaining_columns %}
        <div class="col d-none d-xl-block"></div>
        <div class="col d-none d-xl-block"></div>
    {% endif %}
{% if render_row %}
</div>
{% endif %}
